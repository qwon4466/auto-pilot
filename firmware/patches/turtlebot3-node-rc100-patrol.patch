+void TurtleBot3::publish_rc100_command()
+{
+  const uint8_t button_1_sequence = dxl_sdk_wrapper_->get_data_from_device<uint8_t>(
+    extern_control_table.rc100_button_1_event_sequence.addr,
+    extern_control_table.rc100_button_1_event_sequence.length);
+  const uint8_t button_4_sequence = dxl_sdk_wrapper_->get_data_from_device<uint8_t>(
+    extern_control_table.rc100_button_4_event_sequence.addr,
+    extern_control_table.rc100_button_4_event_sequence.length);
+
+  if (!rc100_sequences_initialized_) {
+    previous_rc100_button_1_sequence_ = button_1_sequence;
+    previous_rc100_button_4_sequence_ = button_4_sequence;
+    rc100_sequences_initialized_ = true;
+    return;
+  }
+
+  const bool stop_requested = button_4_sequence != previous_rc100_button_4_sequence_;
+  const bool start_requested = button_1_sequence != previous_rc100_button_1_sequence_;
+  previous_rc100_button_1_sequence_ = button_1_sequence;
+  previous_rc100_button_4_sequence_ = button_4_sequence;
+
+  if (stop_requested || start_requested) {
+    std_msgs::msg::String command;
+    command.data = stop_requested ? "STOP" : "START";
+    rc100_command_pub_->publish(command);
+    RCLCPP_INFO(this->get_logger(), "RC-100 patrol command: %s", command.data.c_str());
+  }
+}
+
+void TurtleBot3::patrol_state_callback(const std_msgs::msg::String::SharedPtr msg)
+{
+  uint8_t patrol_active = msg->data == "PATROL" ? 1 : 0;
+  std::string sdk_msg;
+  if (!dxl_sdk_wrapper_->set_data_to_device(
+      extern_control_table.patrol_active.addr,
+      extern_control_table.patrol_active.length,
+      &patrol_active,
+      &sdk_msg))
+  {
+    RCLCPP_WARN(
+      this->get_logger(), "Failed to update OpenCR patrol mode: %s", sdk_msg.c_str());
+  }
+}
